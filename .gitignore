# Rust
target/
Cargo.lock.bk

# Electron
electron/node_modules/
electron/.vite/
electron/.test-build/
electron/test-results/
electron/out/
dist/
electron/mando-napi.node

# SQLite WAL files (created at runtime when seed.db is attached)
*-wal
*-shm

# Dev runtime state (PIDs, logs, slot)
.dev/

# AI artifacts
.ai/local/
.ai/evidence/
.ai/media/
# Evidence binaries (screenshots, recordings) and captured command output live
# under .ai/plans/<pr>/ locally but never go into git — they are uploaded to GCS
# and referenced from the PR body via https URLs (see the x-dev-workflow skill).
# The extension patterns catch evidence dropped outside an evidence/ dir.
.ai/plans/**/evidence/
.ai/plans/**/*.png
.ai/plans/**/*.webm
.ai/plans/**/*.mp4
.ai/plans/**/*.gif
.ai/plans/**/*.log
# Task briefs are per-worktree scratch copied in by the captain spawner; only the
# directory itself is tracked, force-added via .gitkeep (see spawner_pr.rs).
.ai/briefs/*
!.ai/briefs/.gitkeep
.claude/worktrees/
.cursor/
.playwright-mcp/

# Worktrees
.worktrees/

# Python
__pycache__/

# OS
.DS_Store
*.swp

# Environment
.env
*.env.local

claude.local.md
ralph-loop.local.md
.claude/ralph-loop.local.md
electron/.ai/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/scheduled-tasks/
.superset/
.vercel
.env*.local
